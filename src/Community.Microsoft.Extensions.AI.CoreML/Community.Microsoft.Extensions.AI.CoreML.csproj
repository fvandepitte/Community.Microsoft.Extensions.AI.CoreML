<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Community.Microsoft.Extensions.AI.CoreML</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Library implementations should reference Abstractions only, not the full Microsoft.Extensions.AI package -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Community.Microsoft.Extensions.AI.CoreML.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the native bridge dylib for macOS arm64 in the NuGet package.
         Run 'make bridge' from the repo root to build the dylib before packing. -->
      <None Include="runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib"
      Condition="Exists('runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib')"
          Pack="true"
      PackagePath="runtimes/osx-arm64/native/" />

      <!-- For local project-reference usage (e.g. TestConsole), place the dylib
        next to the app executable so LibraryImport can load it directly. -->
      <Content Include="runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib"
         Condition="Exists('runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib')"
         CopyToOutputDirectory="PreserveNewest"
         TargetPath="libAppleIntelligenceBridge.dylib" />
  </ItemGroup>

</Project>
