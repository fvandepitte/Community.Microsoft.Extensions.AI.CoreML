<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Community.Microsoft.Extensions.AI.CoreML</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Community.Microsoft.Extensions.AI.CoreML</PackageId>
    <Version>0.1.0-preview1</Version>
    <Authors>Frederiek Vandepitte and contributors</Authors>
    <Company>Community</Company>
    <Description>An IChatClient implementation for Microsoft.Extensions.AI that calls Apple's on-device Foundation Models (Apple Intelligence) directly from .NET via P/Invoke. macOS 26+ on Apple Silicon. No MAUI, no HTTP server.</Description>
    <PackageTags>apple-intelligence;foundation-models;ichatclient;microsoft-extensions-ai;coreml;macos;ai;llm;on-device</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/fvandepitte/Community.Microsoft.Extensions.AI.CoreML</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fvandepitte/Community.Microsoft.Extensions.AI.CoreML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) Frederiek Vandepitte and contributors</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Library implementations should reference Abstractions only, not the full Microsoft.Extensions.AI package -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
    <!-- Needed for IChatClientBuilder / AddChatClient pipeline integration in the DI extension -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Community.Microsoft.Extensions.AI.CoreML.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the native bridge dylib for macOS arm64 in the NuGet package and
         copy it next to the app executable for local project-reference scenarios
         (e.g. TestConsole). Run 'make bridge' from the repo root to build the
         dylib before packing. -->
    <None Include="runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib"
          Condition="Exists('runtimes/osx-arm64/native/libAppleIntelligenceBridge.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/"
          CopyToOutputDirectory="PreserveNewest"
          Link="libAppleIntelligenceBridge.dylib" />

      <!-- README rendered on nuget.org -->
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
